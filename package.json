{
  "name": "technocore-foundry",
  "version": "0.9.0-preview.10",
  "description": "A local-first contribution and portable-proof layer for the Technocore ecosystem.",
  "private": true,
  "license": "Apache-2.0",
  "author": {
    "name": "Mehmet",
    "url": "https://github.com/mehmetkr-31"
  },
  "homepage": "https://github.com/mehmetkr-31/technocore-foundry#readme",
  "bugs": {
    "url": "https://github.com/mehmetkr-31/technocore-foundry/issues"
  },
  "keywords": [
    "local-first",
    "autonomous-agents",
    "did-key",
    "ed25519",
    "signed-receipts",
    "verifiable-contributions"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mehmetkr-31/technocore-foundry.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs",
    "doctor": "node scripts/local-doctor.mjs",
    "signer": "node packages/signer-cli/bin/foundry-signer.mjs",
    "verifier": "node packages/signer-cli/bin/foundry-verifier.mjs",
    "predev": "npm run commons:build",
    "dev": "vinext dev",
    "prebuild": "npm run commons:build",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:migrations": "node scripts/test-migrations.mjs",
    "test:smoke": "node scripts/smoke-lifecycle.mjs",
    "protocol:generate": "node scripts/generate-protocol-fixtures.mjs",
    "test:protocol:ts": "tsx scripts/verify-protocol-fixtures.ts",
    "test:protocol:py": "python3 scripts/verify_protocol_fixtures.py",
    "test:protocol": "npm run protocol:generate && npm run test:protocol:ts && npm run test:protocol:py",
    "test:signer": "node scripts/test-signer-core.mjs && tsx scripts/test-signer-interop.mjs && node scripts/test-dossier-core.mjs",
    "test:observer": "tsx scripts/test-observer.ts",
    "test:security:unit": "tsx scripts/security-unit.ts",
    "test:security:http": "node scripts/security-regression.mjs",
    "test:relay": "tsx scripts/test-technocore-relay.ts",
    "test:security": "npm run test:security:unit && npm run test:relay && npm run test:security:http",
    "commons:build": "node scripts/commons-registry.mjs --write",
    "commons:verify": "node scripts/commons-registry.mjs --verify",
    "commons:check": "node scripts/commons-registry.mjs --check",
    "test:commons": "node scripts/test-commons-registry.mjs && node scripts/test-commons-pr.mjs",
    "test:inspector": "tsx scripts/test-browser-dossier-verifier.mjs",
    "test:tclk": "tsx scripts/test-browser-tclk-inspector.mjs",
    "test:onboarding": "node scripts/test-onboarding.mjs",
    "test:technocore": "tsx scripts/test-technocore-contract.ts",
    "test:participation": "tsx scripts/test-participation-bundle.mjs",
    "upstream:verify": "node scripts/technocore-upstream-watch.mjs --verify",
    "upstream:check": "node scripts/technocore-upstream-watch.mjs --check",
    "tclk:upstream:verify": "node scripts/tclk-upstream-watch.mjs --verify",
    "tclk:upstream:check": "node scripts/tclk-upstream-watch.mjs --check",
    "release:artifacts": "node scripts/generate-release-artifacts.mjs"
  },
  "bin": {
    "foundry-signer": "./packages/signer-cli/bin/foundry-signer.mjs",
    "foundry-verifier": "./packages/signer-cli/bin/foundry-verifier.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@cloudflare/workers-types": "5.20260827.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  },
  "type": "module"
}
