{
  "name": "sites-project",
  "version": "0.9.0-preview.6",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:smoke": "node scripts/smoke-lifecycle.mjs",
    "protocol:generate": "node scripts/generate-protocol-fixtures.mjs",
    "test:protocol:ts": "tsx scripts/verify-protocol-fixtures.ts",
    "test:protocol:py": "python3 scripts/verify_protocol_fixtures.py",
    "test:protocol": "npm run protocol:generate && npm run test:protocol:ts && npm run test:protocol:py",
    "test:signer": "node scripts/test-signer-core.mjs && tsx scripts/test-signer-interop.mjs",
    "test:observer": "tsx scripts/test-observer.ts",
    "test:security": "tsx scripts/security-unit.ts && node scripts/security-regression.mjs",
    "release:artifacts": "node scripts/generate-release-artifacts.mjs"
  },
  "bin": {
    "foundry-signer": "./packages/signer-cli/bin/foundry-signer.mjs",
    "foundry-verifier": "./packages/signer-cli/bin/foundry-verifier.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@cloudflare/workers-types": "5.20260827.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.127.0"
  },
  "type": "module"
}
